# ==========================================
# AIS & Vessel Tracking Configuration (Example)
# ==========================================
# Copy this file to .env and insert your real credentials:

# Generic AIS API Key
AIS_API_KEY=your_ais_api_key_here

# Specific AIS Providers:
# 1. AISStream.io API Key (https://aisstream.io/)
AISSTREAM_API_KEY=your_aisstream_api_key_here

# 2. MarineTraffic API Key (https://www.marinetraffic.com/)
MARINETRAFFIC_API_KEY=your_marinetraffic_api_key_here

# 3. VesselFinder API Key (https://www.vesselfinder.com/)
VESSELFINDER_API_KEY=your_vesselfinder_api_key_here

# 4. Spire Maritime AIS Key (https://spire.com/)
SPIRE_AIS_API_KEY=your_spire_key_here

# 5. Datalastic Maritime Key (https://datalastic.com/)
DATALASTIC_API_KEY=your_datalastic_key_here

# Frontend Environment Variables (Vite)
VITE_AIS_API_KEY=
VITE_AISSTREAM_API_KEY=

# ==========================================
# Backend & Application Settings
# ==========================================
HOST=127.0.0.1
PORT=8000
DEBUG=True
